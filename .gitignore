# Node / pnpm
node_modules/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
out/
dist/
release/
*.tsbuildinfo

# Voice runtime artefacts (created on first shell launch)
daemons/raven-daemon/node_modules/
daemons/raven-core/.venv/
daemons/raven-core/**/__pycache__/

# aether-rag spike: venv + derived vector index (rebuilt by reindex.sh)
daemons/aether-rag/.venv/
daemons/aether-rag/.rag/
daemons/aether-rag/**/__pycache__/

# Runtime / data — per CLAUDE.md §4, `data/` is gitignored
data/
*.db
*.db-journal

# Python bytecode (Core is Python; running it locally creates __pycache__)
__pycache__/
*.py[cod]
*$py.class

# Editor / OS
.vscode/
.idea/
# Ignore user-local Claude state (logs, settings, history) but track
# shared subagents and skills per CLAUDE.md §13.
.claude/*
!.claude/agents/
!.claude/skills/
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Local session state files (Director planning notes, not committed)
_session_state.md

