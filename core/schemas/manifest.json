{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAVEN Mesh Manifest",
  "description": "Top-level shape of a mesh manifest YAML (parsed to JSON).",
  "type": "object",
  "required": ["nodes"],
  "additionalProperties": true,
  "properties": {
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/definitions/relationship" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "category", "surfaces"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Node identifier. Letters, digits, underscore, hyphen. No dots, slashes, or whitespace."
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": ["Sensor", "Actor", "Mixer", "Planner"],
          "description": "Coarse role taxonomy used by the renderer-side mesh viz and by future Planner routing. Sensor: read-only, exposes world state. Actor: changes world state. Mixer: composes other surfaces (briefings, voice). Planner: decides what to invoke next (none yet)."
        },
        "identity_secret": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 280,
              "description": "Human-readable, one-or-two-sentence explanation of what the node does. Consumed by the visualizer node (Sprint 6), raven voice introspection ('what can you do?', Sprint 14), and Aether-Architect when reading existing surface inventory before drafting new ones (Sprint 11). Tweet-length (280 char) max keeps overlays and voice-spoken output reasonable."
            }
          },
          "additionalProperties": true
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/definitions/surface" }
        }
      }
    },
    "surface": {
      "type": "object",
      "required": ["name", "type", "schema"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["inbox", "tool"]
        },
        "invocation_mode": {
          "type": "string",
          "enum": ["request_response", "fire_and_forget"]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": true,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^.]+\\.[^.]+$",
          "description": "node_id.surface_name — must contain exactly one dot."
        }
      }
    }
  }
}
