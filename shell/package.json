{
  "name": "aether-shell",
  "productName": "Aether",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Aether workspace shell \u2014 Electron + React + Tailwind",
  "main": "out/main/index.js",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "predev": "pnpm --filter @aether/mesh-node-sdk build && pnpm --filter @aether/host-notifications build && pnpm --filter @aether/news-feeds build && pnpm --filter @aether/finance build && pnpm --filter @aether/digest build",
    "dev": "electron-vite dev",
    "prebuild": "pnpm --filter @aether/mesh-node-sdk build && pnpm --filter @aether/host-notifications build && pnpm --filter @aether/news-feeds build && pnpm --filter @aether/finance build && pnpm --filter @aether/digest build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:icons": "node scripts/gen-tray-icon.mjs",
    "package": "electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@aether/mesh-node-sdk": "workspace:*",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.554.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
